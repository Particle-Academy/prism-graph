{
    "name": "particle-academy/prism-graph",
    "description": "Long-term memory for AI agents: scoped (tenant, owner, agent, thread), verbatim evidence with trust classes, cited bi-temporal facts, hybrid search and erasure. Built for prism-harness and ACP agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0",
        "particle-academy/prism": ">=0.147.2 <1.0",
        "particle-academy/prism-harness": "^0.24"
    },
    "suggest": {
        "particle-academy/prism": "Embeddings via Prism::embeddings()",
        "particle-academy/prism-harness": "Memory for harness agents: WakeContext and TurnRecorder (0.24+)",
        "ext-pdo_sqlite": "SQLite storage",
        "ext-pdo_pgsql": "PostgreSQL storage (and pgvector)"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Graph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prism\\Graph\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prism\\Graph\\Laravel\\PrismGraphServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
