{
    "name": "particle-academy/prism-graph",
    "description": "Configurable knowledge graphs with embeddings for Prism: verbatim chunks, content-addressed ids, pinned embedders and validity-window facts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0",
        "particle-academy/prism-memory": "^0.4"
    },
    "suggest": {
        "particle-academy/prism": "Embeddings via Prism::embeddings()",
        "ext-pdo_sqlite": "SQLite storage",
        "ext-pdo_pgsql": "PostgreSQL storage (and pgvector)"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Graph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prism\\Graph\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prism\\Graph\\Laravel\\PrismGraphServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
